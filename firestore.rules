rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public portfolio collections:
    // Anyone can read (to render portfolio data)
    // Only authenticated admin can create, update, or delete
    match /projects/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /experiences/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /skills/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /certificates/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /settings/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default deny for all other documents/collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
